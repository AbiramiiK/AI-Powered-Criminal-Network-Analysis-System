# Backend environment variables (names only -- no real values here).
# Copy to .env for local overrides, or set these directly in your hosting
# provider's dashboard (e.g. Render). None are required to run in DEMO MODE --
# the app works with zero environment variables configured.

# Comma-separated list of allowed frontend origins for CORS, e.g.:
#   CORS_ORIGINS=https://your-frontend.vercel.app
# Defaults to "*" (any origin) if unset -- fine for demos, tighten for production.
CORS_ORIGINS=*
